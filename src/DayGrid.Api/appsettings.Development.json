{
  // Local dev overrides. As in appsettings.json, the password fields here are placeholders —
  // prefer `dotnet user-secrets` (see appsettings.json's top comment) over committing real
  // credentials to either file.
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },

  // Local dev keeps using your own Postgres (native install or docker-compose) instead of the
  // embedded instance appsettings.json defaults to for published builds — see Program.cs /
  // EmbeddedDatabase.cs.
  "Database": {
    "Mode": "External"
  },

  "ConnectionStrings": {
    "Default": "Host=localhost;Database=daygrid;Username=daygrid;Password=dev"
  },

  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "User": "onesixwebsolutions@gmail.com",
    "Password": "<app-password>",
    "FromName": "DayGrid"
  },

  "App": {
    "TimeZone": "Asia/Kolkata"
  }
}
