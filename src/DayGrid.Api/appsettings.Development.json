{
  // Local dev overrides. As in appsettings.json, the password fields here are placeholders —
  // prefer `dotnet user-secrets` (see appsettings.json's top comment) over committing real
  // credentials to either file.
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },

  // Local dev keeps using your own Postgres (native install or docker-compose) instead of the
  // embedded instance appsettings.json defaults to for published builds — see Program.cs /
  // EmbeddedDatabase.cs.
  "Database": {
    "Mode": "External",
    // Apply pending schema migrations on startup (upgrades a database created from the old
    // db/init.sql in place).
    "InitializeSchema": true
  },

  "ConnectionStrings": {
    "Default": "Host=localhost;Database=daygrid;Username=daygrid;Password=dev"
  },

  "Email": {
    // Local dev writes account/reminder emails as .eml files instead of sending them:
    // bin/<config>/net8.0/mail-pickup. Set "Smtp" to send for real.
    "Mode": "Pickup",
    "PickupDirectory": "mail-pickup",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "User": "onesixwebsolutions@gmail.com",
    "Password": "<app-password>",
    "FromName": "DayGrid"
  },

  // The Angular dev server (ng serve) is a different origin.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },

  "Auth": {
    // Empty in Development: the first account to confirm its email becomes Admin. To test the
    // Production behaviour, set your own address via user-secrets (Auth:BootstrapAdminEmail),
    // e.g. "you@example.com" — never commit a real address.
    "BootstrapAdminEmail": ""
  },

  "App": {
    "TimeZone": "Asia/Kolkata",
    // The Angular dev server (ng serve proxies /api and /hubs to the API).
    "PublicBaseUrl": "http://localhost:4200"
  }
}
