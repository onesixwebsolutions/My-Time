<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DayGrid.Infrastructure</RootNamespace>
  </PropertyGroup>

  <!-- ASP.NET Core Identity, Data Protection and IHttpContextAccessor (current user). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DayGrid.Domain\DayGrid.Domain.csproj" />
    <ProjectReference Include="..\DayGrid.Application\DayGrid.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.31" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <!-- Used directly by SchemaMigrator; pinned to the latest 8.0.x patch. -->
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.31" />
    <!-- Transitive via Data Protection (XML key ring); pinned to the patched 8.0.x release
         (8.0.2 has several high-severity advisories). Flows to every project referencing this one. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <!-- IANA time zone ids on Windows without ICU (DayGrid.Api runs with InvariantGlobalization). -->
    <PackageReference Include="TimeZoneConverter" Version="6.1.0" />
  </ItemGroup>

  <!--
    Versioned schema migrations (db/migrations/NNNN_name.sql), embedded so the published
    single-file exe and the tests always carry exactly the scripts they were built with.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\db\migrations\*.sql" LogicalName="DayGrid.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
